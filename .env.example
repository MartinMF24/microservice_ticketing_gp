# Puerto HTTP del microservicio (8083 por defecto)
PORT=8083

# Configuración de Conexión a Supabase (PostgreSQL Transaction Pooler - Puerto 6543)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.zprznayvpeijjoiknird
SPRING_DATASOURCE_PASSWORD=uade123uade

# Configuración del Pool Hikari
HIKARI_MAX_POOL_SIZE=3
HIKARI_MIN_IDLE=1
HIKARI_IDLE_TIMEOUT=30000
HIKARI_MAX_LIFETIME=60000
HIKARI_CONNECTION_TIMEOUT=20000

# Integración SOAP F1 Ticketing Legacy
TICKETING_WSDL_URL=http://localhost:8080/ws/ticketing.wsdl
TICKETING_SOAP_ENDPOINT_URL=http://localhost:8080/ws/ticketing
TICKETING_SOAP_CONNECT_TIMEOUT=10000
TICKETING_SOAP_READ_TIMEOUT=20000
TICKETING_SOAP_FALLBACK_ENABLED=true

# Configuración de CRON Diario (03:00 AM UTC)
TICKETING_CRON_ENABLED=true
TICKETING_CRON_EXPRESSION=0 0 3 * * ?
TICKETING_CRON_TIMEZONE=UTC
